# Copy this file to .env. Keep the copy local; .env is ignored by Git.

# Optional Google Gemini credential used by chat and guidance review.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional Amazon Bedrock bearer credential. Set this instead of the Gemini
# key when the selected provider is Bedrock.
AWS_BEARER_TOKEN_BEDROCK=

# Optional Bedrock region. The application defaults to us-east-1 when empty.
AWS_REGION=

# Optional directory for application data and configuration. Leave empty to
# use the platform default location.
REPO_INVENTORY_BASE_DIR=
