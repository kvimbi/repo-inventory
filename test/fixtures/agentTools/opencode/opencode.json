{
  // OpenCode user configuration fixture
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "github": {
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-github",
        ],
        "env": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_synthetic_token_test",
        },
      },
      "fetch": {
        "command": "uvx",
        "args": [
          "mcp-server-fetch",
        ],
      },
    },
  },
  "lsp": {
    "typescript": {
      "command": "typescript-language-server",
      "args": [
        "--stdio",
      ],
    },
  },
}
